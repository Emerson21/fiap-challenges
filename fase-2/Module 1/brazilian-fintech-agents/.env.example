# Environment variables for Brazilian Fintech Agents pipeline
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit your actual API key.

# Google Gemini API key (required for LLM mode)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (optional — defaults to gemini-3.6-flash)
# Options: gemini-3.6-flash | gemini-2.5-pro | gemini-1.5-flash
GEMINI_MODEL=gemini-3.6-flash
